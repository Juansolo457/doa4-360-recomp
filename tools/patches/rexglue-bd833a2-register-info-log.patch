+namespace {
+// A bit for each register named in register_table.inc, so a write can tell an unknown register
+// without GetRegisterInfo, a switch over all of them: on the Steam Deck that was a tenth of this
+// thread's time, which the frame rate waits on, and checking the log level first still cost 6%
+// (doa4-360-recomp).
+constexpr auto kKnownRegisters = [] {
+  std::array<uint64_t, (RegisterFile::kRegisterCount + 63) / 64> known{};
+#define XE_GPU_REGISTER(index, type, name)    \
+  if ((index) < RegisterFile::kRegisterCount) \
+    known[(index) / 64] |= uint64_t(1) << ((index) % 64);
+#include <rex/graphics/register_table.inc>
+#undef XE_GPU_REGISTER
+  return known;
+}();
+}  // namespace
+
 uint32_t CommandProcessor::ReadRegisterValue(uint32_t index) const {
   if (index < RegisterFile::kRegisterCount) {
     return register_file_->values[index];
@@ -361,7 +378,7 @@ void CommandProcessor::WriteRegister(uint32_t index, uint32_t value) {
 
   // Volatile for the WAIT_REG_MEM loop.
   const_cast<volatile uint32_t&>(regs.values[index]) = value;
-  if (!regs.GetRegisterInfo(index)) {
+  if (!((kKnownRegisters[index / 64] >> (index % 64)) & 1)) {
     REXGPU_DEBUG("GPU: Write to unknown register ({:04X} = {:08X})", index, value);
   }
 
