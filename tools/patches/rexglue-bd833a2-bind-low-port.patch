+namespace {
+// Guest ports below 1024 live 10000 higher on the host, on every machine: Linux (and so Wine and
+// Proton) refuses them to a normal user, and a game whose bind fails may skip making the socket
+// non-blocking and then wait in recvfrom for ever (doax2-360-recomp on the Steam Deck: system
+// link's VDP socket on port 1000, no first frame). Mapping binds, destinations and sources the
+// same way everywhere keeps two hosts able to reach each other; the guest only sees its ports.
+constexpr uint16_t kLowPortOffset = 10000;
+uint16_t HostPort(uint16_t guest_port) {
+  return (guest_port != 0 && guest_port < 1024) ? uint16_t(guest_port + kLowPortOffset)
+                                                : guest_port;
+}
+uint16_t GuestPort(uint16_t host_port) {
+  return (host_port > kLowPortOffset && host_port < kLowPortOffset + 1024)
+             ? uint16_t(host_port - kLowPortOffset)
+             : host_port;
+}
+}  // namespace
+
 X_STATUS XSocket::Connect(N_XSOCKADDR* name, int name_len) {
-  int ret = connect(native_handle_, (sockaddr*)name, name_len);
+  N_XSOCKADDR mapped = *name;
+  if (mapped.address_family == AF_INET) {
+    // sa_data starts with the port, in network order (as the guest wrote it).
+    const uint16_t port =
+        uint16_t((uint8_t(mapped.sa_data[0]) << 8) | uint8_t(mapped.sa_data[1]));
+    const uint16_t host_port = HostPort(port);
+    mapped.sa_data[0] = char(host_port >> 8);
+    mapped.sa_data[1] = char(host_port & 0xFF);
+  }
+  int ret = connect(native_handle_, (sockaddr*)&mapped, name_len);
   if (ret < 0) {
     return X_STATUS_UNSUCCESSFUL;
   }
@@ -115,7 +143,14 @@ X_STATUS XSocket::Connect(N_XSOCKADDR* name, int name_len) {
 }
 
 X_STATUS XSocket::Bind(N_XSOCKADDR_IN* name, int name_len) {
-  int ret = bind(native_handle_, (sockaddr*)name, name_len);
+  // sin_port is stored big-endian (network order), so the struct binds as it is once mapped.
+  N_XSOCKADDR_IN mapped = *name;
+  const uint16_t port = name->sin_port;
+  mapped.sin_port = HostPort(port);
+  int ret = bind(native_handle_, (sockaddr*)&mapped, name_len);
+  if (ret >= 0 && uint16_t(mapped.sin_port) != port) {
+    REXSYS_INFO("XSocket::Bind: guest port {} is host port {}", port, uint16_t(mapped.sin_port));
+  }
   if (ret < 0) {
     return X_STATUS_UNSUCCESSFUL;
   }
