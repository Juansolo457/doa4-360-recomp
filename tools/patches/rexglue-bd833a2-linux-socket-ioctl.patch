+namespace {
+// The guest's last error after a failed socket call, as a Winsock code. On POSIX the host reports
+// errno, and passing 0 instead left a game polling a non-blocking socket unable to see
+// WSAEWOULDBLOCK, so it never stopped (doax2-360-recomp: system link at start-up on Linux).
+void SetLastSocketError() {
+#if REX_PLATFORM_WIN32
+  XThread::SetLastError(WSAGetLastError());
+#else
+  uint32_t code;
+  switch (errno) {
+    case EWOULDBLOCK: code = 10035; break;  // WSAEWOULDBLOCK (EAGAIN is the same on Linux)
+    case EINPROGRESS: code = 10036; break;
+    case EALREADY: code = 10037; break;
+    case ENOTSOCK: code = 10038; break;
+    case EDESTADDRREQ: code = 10039; break;
+    case EMSGSIZE: code = 10040; break;
+    case EADDRINUSE: code = 10048; break;
+    case EADDRNOTAVAIL: code = 10049; break;
+    case ENETDOWN: code = 10050; break;
+    case ENETUNREACH: code = 10051; break;
+    case ECONNABORTED: code = 10053; break;
+    case ECONNRESET: code = 10054; break;
+    case ENOBUFS: code = 10055; break;
+    case EISCONN: code = 10056; break;
+    case ENOTCONN: code = 10057; break;
+    case ESHUTDOWN: code = 10058; break;
+    case ETIMEDOUT: code = 10060; break;
+    case ECONNREFUSED: code = 10061; break;
+    case EHOSTUNREACH: code = 10065; break;
+    case EINTR: code = 10004; break;
+    case EACCES: code = 10013; break;
+    case EFAULT: code = 10014; break;
+    default: code = 10022; break;  // WSAEINVAL
+  }
+  XThread::SetLastError(code);
+#endif
+}
+}  // namespace
