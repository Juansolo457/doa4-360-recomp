--- a/src/core/socket_posix.cpp
+++ b/src/core/socket_posix.cpp
@@ -3,17 +3,58 @@
 
 static_assert(REX_PLATFORM_LINUX || REX_PLATFORM_MAC, "This file is POSIX-only");
 
+#include <cerrno>
+#include <cstring>
+
 #include <sys/ioctl.h>
 #include <unistd.h>
 
 namespace rex::net {
 
+namespace {
+// The guest calls ioctlsocket with Winsock's command codes and a big-endian u_long; Linux's
+// ioctl has its own codes (FIONBIO is 0x5421, not 0x8004667E) and reads a host int. Passed
+// through unchanged, the call failed, so a game's non-blocking socket stayed blocking and its
+// recvfrom waited for ever (doax2-360-recomp: system link's socket, no first frame on Linux).
+constexpr uint32_t kWinsockFionbio = 0x8004667E;
+constexpr uint32_t kWinsockFionread = 0x4004667F;
+
+uint32_t LoadBe32(const uint8_t* p) {
+  uint32_t v;
+  std::memcpy(&v, p, sizeof(v));
+  return __builtin_bswap32(v);
+}
+void StoreBe32(uint8_t* p, uint32_t v) {
+  v = __builtin_bswap32(v);
+  std::memcpy(p, &v, sizeof(v));
+}
+}  // namespace
+
 int socket_close(SocketHandle handle) {
   return close(static_cast<int>(handle));
 }
 
 int socket_ioctl(SocketHandle handle, uint32_t cmd, uint8_t* arg) {
-  return ioctl(static_cast<int>(handle), cmd, arg);
+  const int fd = static_cast<int>(handle);
+  if (!arg) {
+    errno = EFAULT;
+    return -1;
+  }
+  switch (cmd) {
+    case kWinsockFionbio: {
+      int non_blocking = LoadBe32(arg) != 0;
+      return ioctl(fd, FIONBIO, &non_blocking);
+    }
+    case kWinsockFionread: {
+      int available = 0;
+      const int ret = ioctl(fd, FIONREAD, &available);
+      if (ret == 0) StoreBe32(arg, static_cast<uint32_t>(available));
+      return ret;
+    }
+    default:
+      errno = EINVAL;
+      return -1;
+  }
 }
 
 }  // namespace rex::net
